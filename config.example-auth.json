{
  "server": {
    "proxyEnabled": false,
    "proxyServers": [],
    "execPath": "/usr/bin/chromium-browser",
    "maxMemoryUsage": 500
  },
  "panel": {
    "discordToken": "YOUR_DISCORD_BOT_TOKEN_HERE",
    "discordPrefix": "!",
    "mastersDiscordId": ["YOUR_DISCORD_USER_ID_HERE"],
    "maxRooms": 5,
    "bots": {
      "example": {
        "path": "./bots/futsal-example.js"
      },
      "auth-room": {
        "path": "./bots/auth-bot-example.js",
        "displayName": "Sala CIRS com Autenticacao"
      }
    },
    "customSettings": {
      "default": {
        "reserved": {
          "haxball": {
            "maxPlayers": 10,
            "public": true,
            "noPlayer": false,
            "password": "",
            "geo": { "code": "BR", "lat": -23.5505, "lon": -46.6333 }
          }
        },
        "roomName": "Sala Padrao",
        "playerName": "Host",
        "token": "YOUR_HAXBALL_TOKEN_HERE"
      },
      "auth-settings": {
        "extends": "default",
        "roomName": "[CIRS] Sala com Autenticacao",
        "reserved": {
          "haxball": {
            "maxPlayers": 12,
            "public": true
          }
        },
        "features": {
          "authentication": true,
          "autoLogin": true,
          "minRanking": 1000
        }
      }
    }
  }
}
